# Fastlane — build the currently-selected Capacitor app and ship it to TestFlight.
#
# One lane serves every app in mobile/apps.mjs: run `node scripts/cap-select.mjs <slug>` first
# (npm run app:select) so capacitor.config.json + the generated ios/ project carry that app's
# bundle id, then `fastlane ios beta`. Auth is an App Store Connect API key (no 2FA in CI).
#
# Required env (see mobile/AUTOMATION.md for how to get each):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH   → App Store Connect API key (.p8)
# Optional:
#   SCHEME (default "App"), APPLE_TEAM_ID, MATCH_GIT_URL + MATCH_PASSWORD (CI signing)

default_platform(:ios)

# Load the repo's gitignored secret store so `npm run beta` needs no manual exports — the same
# .env.local that holds the DB/R2/Stripe creds now also carries ASC_KEY_ID / ASC_ISSUER_ID /
# ASC_KEY_PATH / APPLE_TEAM_ID. Missing file (e.g. on CI, which injects env via secrets) is a
# no-op; real env vars already set always win over the file.
env_local = File.expand_path('../.env.local', __dir__)
if File.exist?(env_local)
  require 'dotenv'
  Dotenv.load(env_local)
end

WORKSPACE = 'ios/App/App.xcworkspace'.freeze

platform :ios do
  desc 'Build the selected app and upload it to TestFlight'
  lane :beta do
    setup_ci if ENV['CI'] # ephemeral keychain on CI runners; no-op locally

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: ENV.fetch('ASC_KEY_PATH'),
      in_house: false,
    )

    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    # Signing:
    #  · CI / reproducible → set MATCH_GIT_URL (a private repo of encrypted certs). `match`
    #    creates/fetches the distribution cert + App Store profile for this bundle id.
    #  · First local run → skip match and let Xcode automatic signing handle it (sign in to
    #    Xcode once). Set the team so the CLI build can sign non-interactively.
    if ENV['MATCH_GIT_URL']
      match(
        type: 'appstore',
        app_identifier: [bundle_id],
        readonly: ENV['CI'] == 'true',
        api_key: api_key,
      )
    end

    build_app(
      workspace: WORKSPACE,
      scheme: ENV['SCHEME'] || 'App',
      export_method: 'app-store',
      output_directory: 'ios/build',
      clean: true,
      xcargs: ENV['APPLE_TEAM_ID'] ? "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}" : nil,
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true, # don't block the run waiting on Apple processing
      distribute_external: false,              # internal testers only — no extra review
    )

    UI.success("Uploaded #{bundle_id} to TestFlight — it'll appear once Apple finishes processing.")
  end

  desc 'Preflight: verify creds authenticate + the selected app exists on App Store Connect (no build, no upload)'
  lane :preflight do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      filepath: File.expand_path(ENV.fetch('ASC_KEY_PATH')),
    )
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    UI.success('Authenticated to App Store Connect ✓')

    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app
      UI.success("App record EXISTS: \"#{app.name}\" (#{bundle_id}) — ready for `npm run beta`.")
    else
      UI.important("No App Store Connect record for #{bundle_id} yet.")
      UI.important('Create it: App Store Connect → Apps → + → New App (that bundle id), then rerun preflight.')
    end
  end

  desc 'Upload App Store listing metadata + screenshots for the selected app (no build, no submit)'
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: ENV.fetch('ASC_KEY_PATH'),
      in_house: false,
    )

    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    slug = bundle_id.split('.').last                       # com.hundredlights.<slug>
    meta = File.expand_path("metadata/#{slug}", __dir__)   # generated by `npm run store:metadata`
    shots = File.expand_path("screenshots/#{slug}", __dir__)
    UI.user_error!("No metadata at #{meta} — run `npm run store:metadata` first.") unless File.directory?(meta)

    # Metadata-only push: never touches the binary or the app version, and never submits
    # for review — safe to run repeatedly to keep each listing's distinct copy in sync.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: bundle_id,
      metadata_path: meta,
      screenshots_path: (File.directory?(shots) ? shots : nil),
      skip_binary_upload: true,
      skip_app_version_update: true,
      overwrite_screenshots: File.directory?(shots),
      force: true,                          # non-interactive — no HTML preview prompt
      run_precheck_before_submit: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
    UI.success("Uploaded listing metadata#{File.directory?(shots) ? ' + screenshots' : ''} for #{slug} (#{bundle_id}).")
  end
end
