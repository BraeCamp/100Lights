# Control-plane AGENT image (browserless) — one box that runs several channels at once and is driven
# from the dashboard. node:20-slim + ffmpeg + the agent, which spawns a render.mjs child per assigned
# channel. No Chromium, so many streams share one box with no display/audio plumbing. Ideal for a
# Hetzner baseline server.
FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY agent.mjs render.mjs ./
ENV AGENT=1 RENDERER=ffmpeg
CMD ["node", "agent.mjs"]
