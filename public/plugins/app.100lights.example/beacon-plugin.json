{
  "formatVersion": 1,
  "id": "app.100lights.example",
  "name": "Example Synth",
  "vendor": "100Lights",
  "version": "1.0.0",
  "kind": "instrument",
  "description": "A small two-oscillator synth that exists to show what a Beacon plugin looks like. Copy this folder to start your own — it is about 300 lines of plain JavaScript with no build step.",
  "processor": "processor.js",
  "processorName": "beacon-example-synth",
  "outputs": 2,
  "parameters": [
    { "kind": "choice", "id": "osc1Wave", "name": "Osc 1", "group": "Oscillators",
      "choices": ["Sine", "Triangle", "Saw", "Square"], "default": 2 },
    { "kind": "choice", "id": "osc2Wave", "name": "Osc 2", "group": "Oscillators",
      "choices": ["Sine", "Triangle", "Saw", "Square"], "default": 3 },
    { "kind": "float", "id": "oscMix", "name": "Mix", "group": "Oscillators",
      "min": 0, "max": 1, "default": 0.35, "precision": 2,
      "tooltip": "0 is only oscillator 1, 1 is only oscillator 2" },
    { "kind": "float", "id": "detune", "name": "Detune", "group": "Oscillators",
      "min": -50, "max": 50, "default": 7, "unit": "ct", "precision": 1 },
    { "kind": "int", "id": "octave2", "name": "Osc 2 Octave", "group": "Oscillators",
      "min": -2, "max": 2, "default": 0 },

    { "kind": "float", "id": "cutoff", "name": "Cutoff", "group": "Filter",
      "min": 30, "max": 18000, "default": 2400, "unit": "Hz", "curve": "log" },
    { "kind": "float", "id": "resonance", "name": "Resonance", "group": "Filter",
      "min": 0, "max": 1, "default": 0.2, "precision": 2 },
    { "kind": "float", "id": "filterEnv", "name": "Env Amount", "group": "Filter",
      "min": -1, "max": 1, "default": 0.4, "precision": 2 },

    { "kind": "float", "id": "attack", "name": "Attack", "group": "Envelope",
      "min": 0.001, "max": 5, "default": 0.008, "unit": "s", "curve": "exp", "precision": 3 },
    { "kind": "float", "id": "decay", "name": "Decay", "group": "Envelope",
      "min": 0.005, "max": 8, "default": 0.35, "unit": "s", "curve": "exp", "precision": 3 },
    { "kind": "float", "id": "sustain", "name": "Sustain", "group": "Envelope",
      "min": 0, "max": 1, "default": 0.7, "precision": 2 },
    { "kind": "float", "id": "release", "name": "Release", "group": "Envelope",
      "min": 0.005, "max": 8, "default": 0.3, "unit": "s", "curve": "exp", "precision": 3 },

    { "kind": "float", "id": "delayMix", "name": "Delay", "group": "Output",
      "min": 0, "max": 1, "default": 0.15, "precision": 2 },
    { "kind": "float", "id": "delayTime", "name": "Time", "group": "Output",
      "min": 0.02, "max": 1.5, "default": 0.28, "unit": "s", "precision": 3 },
    { "kind": "float", "id": "delayFeedback", "name": "Feedback", "group": "Output",
      "min": 0, "max": 0.95, "default": 0.35, "precision": 2 },
    { "kind": "float", "id": "gain", "name": "Level", "group": "Output",
      "min": -40, "max": 6, "default": -8, "unit": "dB", "precision": 1 }
  ],
  "presets": [
    { "name": "Init", "values": {} },
    { "name": "Soft Keys", "category": "Keys",
      "values": { "osc1Wave": 1, "osc2Wave": 0, "cutoff": 1600, "attack": 0.02, "release": 0.6, "delayMix": 0.2 } },
    { "name": "Hard Lead", "category": "Lead",
      "values": { "osc1Wave": 2, "osc2Wave": 2, "detune": 14, "cutoff": 6000, "resonance": 0.35, "filterEnv": 0.6, "attack": 0.002, "decay": 0.2, "sustain": 0.85 } },
    { "name": "Deep Bass", "category": "Bass",
      "values": { "osc1Wave": 2, "osc2Wave": 0, "octave2": -1, "oscMix": 0.5, "detune": 0, "cutoff": 420, "resonance": 0.3, "filterEnv": 0.55, "attack": 0.003, "decay": 0.5, "sustain": 0.4, "release": 0.15, "delayMix": 0 } }
  ]
}
