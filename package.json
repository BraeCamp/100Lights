{
  "name": "100lights",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test:merge": "tsc lib/project-merge.ts --outDir .test-build --rootDir lib --target es2022 --module esnext --moduleResolution bundler --skipLibCheck && node scripts/project-merge.test.mjs",
    "test:session": "node lib/session-capture/session-capture.test.mjs",
    "validate:articles": "node scripts/validate-articles.mjs",
    "build-tutorial-song": "tsc lib/daw-types.ts --outDir .fixture-build --rootDir lib --target es2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck && node scripts/build-tutorial-song.mjs",
    "capture-tutorials": "node scripts/capture-tutorials.mjs",
    "prebuild": "node scripts/validate-articles.mjs && node scripts/check-presets.mjs && node scripts/gen-site-pages.mjs",
    "build": "next build",
    "pages:gen": "node scripts/gen-site-pages.mjs",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "cap sync",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android",
    "app:select": "node scripts/cap-select.mjs",
    "app:add-ios": "node scripts/cap-select.mjs $APP && cap add ios && cap sync ios && node scripts/ios-postsync.mjs",
    "beta": "bundle exec fastlane ios beta",
    "beta:check": "bundle exec fastlane ios preflight",
    "store:metadata": "node scripts/gen-store-metadata.mjs",
    "store:metadata:check": "node scripts/gen-store-metadata.mjs --check",
    "store:icons": "node scripts/gen-app-icons.mjs",
    "store:screenshots": "node scripts/gen-app-screenshots.mjs",
    "bg:images": "node scripts/gen-bg-images.mjs",
    "bg:videos": "node scripts/gen-bg-videos.mjs",
    "bg:fetch": "node scripts/fetch-bg-clips.mjs",
    "bg:publish": "node scripts/publish-bg-clips.mjs",
    "bg:tag": "node scripts/tag-bg-clips.mjs",
    "store:upload": "bundle exec fastlane ios metadata",
    "bg:pexels": "node scripts/seed-pexels-bg.mjs",
    "clap:setup": "python3 -m venv .venv-clap && ./.venv-clap/bin/pip install -q torch transformers librosa soundfile",
    "embed:jamendo": "node scripts/embed-jamendo.mjs",
    "looks:centroids": "node scripts/build-genre-centroids.mjs",
    "calibrate:looks": "node scripts/calibrate-classifier.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@clerk/nextjs": "^7.5.1",
    "@clerk/themes": "^2.4.57",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@huggingface/transformers": "^4.2.0",
    "@liveblocks/client": "^3.22.0",
    "@liveblocks/node": "^3.22.0",
    "@liveblocks/react": "^3.22.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.57.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mp4-muxer": "^5.2.2",
    "next": "16.2.7",
    "pg": "^8.22.0",
    "posthog-js": "^1.386.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "stripe": "^22.2.1",
    "svix": "^1.95.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
